  "break_after": false,
  "file": "line_051.wav",
  "bleeps": [],
  "duration": 4.047,
  "voice": "am_puck",
  "speed": 1.0
 },
 {
  "text": "I believe that's from God. Whatever you believe, that's up to you.",
  "exaggeration": 0.5,
  "break_after": false,
  "file": "line_052.wav",
  "bleeps": [],
  "duration": 3.098,
  "voice": "am_puck",
  "speed": 1.0
 },
 {
  "text": "I'm not saying don't chase love. Chase a healthy one. A loving wife. A loving husband. Hardworking. Respectful. Grinding for each other. Kids.",
  "exaggeration": 0.5,
  "break_after": false,
  "file": "line_053.wav",
  "bleeps": [],
  "duration": 8.074,
  "voice": "am_puck",
  "speed": 1.0
 },
 {
