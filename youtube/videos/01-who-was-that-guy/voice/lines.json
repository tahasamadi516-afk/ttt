  "file": "line_034.wav",
  "bleeps": [],
  "duration": 4.922,
  "voice": "am_puck",
  "speed": 1.0
 },
 {
  "text": "Hold on. My neighbor is staring at me through his window. What the hell. Anyway.",
  "exaggeration": 0.5,
  "break_after": true,
  "file": "line_035.wav",
  "bleeps": [],
  "duration": 3.802,
  "voice": "am_puck",
  "speed": 1.0
 },
 {
  "text": "I'm not saying I'm better than her. Everybody is better than this. Even her.",
  "exaggeration": 0.5,
