   [
    1.2807,
    0.32
   ]
  ],
  "duration": 1.661,
  "voice": "am_puck",
  "speed": 1.0
 },
 {
  "text": "And if I catch you at McDonald's, I hope God strikes you with thunder. Do you know how many ingredients are in that thing?",
